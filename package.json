{
  "name": "course-project",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "lint": "npm run lint-typecheck && npm run lint-eslint && npm run lint-prettier && npm run lint-knip",
    "lint-typecheck": "tsc --noEmit",
    "lint-eslint": "eslint .",
    "lint-prettier": "prettier --check .",
    "lint-knip": "knip",
    "start": "expo start",
    "test": "jest --watchAll"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "imports": {
    "#shared": "./src/shared/index.tsx",
    "#shared/*": "./src/shared/*/index.tsx",
    "#features/*": "./src/features/*/index.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.0",
    "expo-constants": "~56.0.17",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.13",
    "expo-location": "~56.0.16",
    "expo-notifications": "~56.0.16",
    "expo-router": "~56.2.9",
    "expo-sensors": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.18",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.4",
    "knip": "^6.14.1",
    "prettier": "^3.8.3",
    "react-test-renderer": "^19.1.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
